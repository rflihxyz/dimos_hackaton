# Copy this file to `.env` and fill in the values before running:
#   docker compose -f docker-compose.dev.yml up --build

# --- App ---
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_ORIGIN_REGEX=

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dimos
# `postgres` is the docker-compose service name; use `localhost` if running the
# backend outside docker.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Webapp ---
# URL the browser uses to reach the backend (so `localhost`, not the service name).
NEXT_PUBLIC_API_URL=http://localhost:8000
