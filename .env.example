# Copy this file to `.env` and fill in the values before running:
#   docker compose -f docker-compose.dev.yml up --build

# --- App ---
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_ORIGIN_REGEX=

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dimos
# `postgres` is the docker-compose service name; use `localhost` if running the
# backend outside docker.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
JWT_SECRET_

# --- Webapp ---
# URL the browser uses to reach the backend (so `localhost`, not the service name).
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL the browser uses to reach the dimos webserver for MJPEG video + agent SSE.
NEXT_PUBLIC_DIMOS_URL=http://localhost:5555

# --- DimOS bridge ---
# The broker (inside docker) reaches dimos (on the host) via host.docker.internal.
DIMOS_MCP_URL=http://host.docker.internal:9990/mcp
DIMOS_VIDEO_URL=http://host.docker.internal:5555
# What the browser should use for the MCP URL (handy if it ever talks direct).
NEXT_PUBLIC_DIMOS_MCP_URL=http://localhost:9990/mcp

# --- RBAC-gated agent ---
# Export this in the *host* shell before `dimos run …` so dimos's
# McpClient routes its tool calls through the broker's RBAC gateway
# instead of straight to its local McpServer. The broker runs on the
# host's port 8000 (docker-compose publishes it).
#   export DIMOS_MCP_GATEWAY_URL=http://localhost:8000/mcp
# Leaving this unset = no enforcement: dimos talks to itself as before.

# --- LLM ---
# Used by `POST /recipes/draft` (pydantic-ai → OpenAI GPT-5.5).
OPENAI_API_KEY=

EXA_API_KEY=