{
  "openapi": "3.1.0",
  "info": {
    "title": "Dimos API",
    "description": "Backend API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://0.0.0.0:8000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "healthchecks"
        ],
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "healthchecks"
        ],
        "summary": "Read Health",
        "operationId": "read_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/refresh-openapi": {
      "get": {
        "tags": [
          "healthchecks"
        ],
        "summary": "Refresh Openapi",
        "description": "Manual endpoint to refresh the OpenAPI JSON file",
        "operationId": "refresh_openapi_refresh_openapi_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/recipes": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "List Recipes",
        "operationId": "list_recipes_recipes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecipeRow"
                  },
                  "type": "array",
                  "title": "Response List Recipes Recipes Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "recipes"
        ],
        "summary": "Create Recipe",
        "operationId": "create_recipe_recipes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Recipe"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeRow"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recipes/draft": {
      "post": {
        "tags": [
          "recipes"
        ],
        "summary": "Draft Recipe",
        "operationId": "draft_recipe_recipes_draft_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeDraftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recipes/{name}": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "Get Recipe",
        "operationId": "get_recipe_recipes__name__get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeRow"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "recipes"
        ],
        "summary": "Delete Recipe",
        "operationId": "delete_recipe_recipes__name__delete",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recipes/{name}/invoke": {
      "post": {
        "tags": [
          "recipes"
        ],
        "summary": "Invoke Recipe",
        "description": "Tell the running agent to use this learned skill.\n\nUses the chat-driven path (`agent_send`) so the LLM stays in the loop\nand emits progress on the SSE stream.",
        "operationId": "invoke_recipe_recipes__name__invoke_post",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Invoke Recipe Recipes  Name  Invoke Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runtime": {
      "get": {
        "tags": [
          "runtime"
        ],
        "summary": "Runtime Info",
        "operationId": "runtime_info_runtime_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeInfo"
                }
              }
            }
          }
        }
      }
    },
    "/agents/status": {
      "get": {
        "tags": [
          "agents"
        ],
        "summary": "Agent Status",
        "operationId": "agent_status_agents_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Agent Status Agents Status Get"
                }
              }
            }
          }
        }
      }
    },
    "/agents/send": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Agent Send",
        "operationId": "agent_send_agents_send_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentSendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Agent Send Agents Send Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/agents/stream": {
      "get": {
        "tags": [
          "agents"
        ],
        "summary": "Agent Stream",
        "description": "Server-Sent Events proxy of dimos's MCP SSE channel.\n\nThe browser could hit `dimos:9990` directly, but proxying through the\nbroker gives us a single CORS-friendly origin and lets us add request\nlogging.",
        "operationId": "agent_stream_agents_stream_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentSendRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AgentSendRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Recipe": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Description"
          },
          "mode": {
            "type": "string",
            "enum": [
              "vlm",
              "yoloe"
            ],
            "title": "Mode"
          },
          "vlm_query": {
            "type": "string",
            "maxLength": 1024,
            "title": "Vlm Query",
            "default": ""
          },
          "yoloe_prompts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Yoloe Prompts"
          },
          "exemplar_image_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Exemplar Image Refs"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "created_by": {
            "type": "string",
            "maxLength": 64,
            "title": "Created By",
            "default": "anonymous"
          },
          "version": {
            "type": "integer",
            "title": "Version",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "mode"
        ],
        "title": "Recipe",
        "description": "A v0 recipe JSON document.\n\n`name` must match the on-disk file stem and is the value passed to\n`lookout_learned_skill(name=...)` on the dimos side."
      },
      "RecipeDraftRequest": {
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Description"
          },
          "name_hint": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Name Hint"
          }
        },
        "type": "object",
        "required": [
          "description"
        ],
        "title": "RecipeDraftRequest",
        "description": "Body for `POST /recipes/draft`."
      },
      "RecipeRow": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "recipe": {
            "$ref": "#/components/schemas/Recipe"
          },
          "live": {
            "type": "boolean",
            "title": "Live",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "status",
          "created_at",
          "recipe"
        ],
        "title": "RecipeRow",
        "description": "A persisted recipe as returned by the REST surface."
      },
      "RuntimeInfo": {
        "properties": {
          "video_url": {
            "type": "string",
            "title": "Video Url"
          },
          "agent_sse_url": {
            "type": "string",
            "title": "Agent Sse Url"
          },
          "mcp_url": {
            "type": "string",
            "title": "Mcp Url"
          },
          "dimos_status": {
            "type": "string",
            "title": "Dimos Status"
          }
        },
        "type": "object",
        "required": [
          "video_url",
          "agent_sse_url",
          "mcp_url",
          "dimos_status"
        ],
        "title": "RuntimeInfo"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "healthchecks",
      "description": "Healthcheck endpoints"
    }
  ]
}