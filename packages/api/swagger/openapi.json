      "CategoryInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Stable enum value, e.g. 'observe'."
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Human-readable title for the UI."
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "examples": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Examples"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills",
            "description": "DimOS MCP skill names gated by this category."
          }
        },
        "type": "object",
        "required": [
          "name",
          "label",
          "description",
          "examples",
          "skills"
        ],
        "title": "CategoryInfo",
        "description": "One row of the action taxonomy."
      },
